{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@denguespot/domain": ["./packages/domain/src/index.ts"],
      "@denguespot/security": ["./packages/security/src/index.ts"],
      "@denguespot/db": ["./packages/db/src/index.ts"],
      "@denguespot/config": ["./packages/config/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/worker/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next"]
}
